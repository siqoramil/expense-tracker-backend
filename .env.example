PORT=3000
HOST=0.0.0.0
# Append "?replicaSet=rs0" once you've initiated a replica set so /tx writes
# can run inside a transaction. Standalone mongo also works (non-atomic).
MONGO_URL=mongodb://localhost:10100/expense-tracker
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Comma-separated list of allowed CORS origins (production).
# In development, localhost / 192.168.x.x / 10.x.x.x are auto-allowed.
CORS_ORIGINS=

# Set to "true" only when running behind a reverse proxy / TLS terminator
# that sets X-Forwarded-For. Required for correct per-IP rate limiting.
# Leave false in dev — trusting the header without a proxy lets clients
# spoof their source IP.
TRUST_PROXY=false

# Google OAuth Client IDs — https://console.cloud.google.com/apis/credentials
# All three are accepted as ID-token audiences; leave blank to disable Google sign-in.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Gmail SMTP for verification codes.
# Generate an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification on the Google account).
# If SMTP_USER/SMTP_PASS are empty, codes are logged to the server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Expense Tracker <noreply@example.com>
