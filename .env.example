PORT=3000
HOST=0.0.0.0
MONGO_URL=mongodb://localhost:10100/expense-tracker
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Comma-separated list of allowed CORS origins (production).
# In development, localhost / 192.168.x / 10.x are auto-allowed.
CORS_ORIGINS=

# Google OAuth Client IDs — https://console.cloud.google.com/apis/credentials
# All three are accepted as ID-token audiences; leave blank to disable Google sign-in.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Gmail SMTP for verification codes.
# Generate an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification on the Google account).
# If SMTP_USER/SMTP_PASS are empty, codes are logged to the server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Expense Tracker <noreply@example.com>
